@model AdminOrderListViewModel

<div class="admin-page-head">
    <div>
        <h1 class="admin-page-title">@L["Admin.OrdersTitle"]</h1>
        <p class="admin-page-subtitle">@L["Admin.OrdersSubtitle"]</p>
    </div>
    <div class="admin-head-actions">
        <span class="badge badge-neutral mono">@L["Admin.TotalRecords", Model.TotalCount]</span>
    </div>
</div>

<div class="admin-filter-pills" role="navigation" aria-label="@L["Admin.OrdersTitle"]">
    <a class="admin-pill @(!Model.StatusFilter.HasValue ? "is-active" : "")"
       asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-search="@Model.Search">
        <span>@L["Orders.FilterAll"]</span>
        <span class="admin-pill-count mono">@Model.AllOrdersCount</span>
    </a>
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        var count = Model.StatusCounts.GetValueOrDefault(status);
        var isActive = Model.StatusFilter == status;
        <a class="admin-pill @(isActive ? "is-active" : "")"
           asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="@status" asp-route-search="@Model.Search">
            <span>@L[status.GetStatusResourceKey()]</span>
            <span class="admin-pill-count mono">@count</span>
        </a>
    }
</div>

<form class="panel-card admin-toolbar" method="get" asp-area="Admin" asp-controller="Orders" asp-action="Index">
    @if (Model.StatusFilter.HasValue)
    {
        <input type="hidden" name="status" value="@Model.StatusFilter" />
    }
    <div class="admin-toolbar-search-row">
        <input type="search"
               name="search"
               value="@Model.Search"
               class="input input-sm"
               placeholder="@L["Admin.OrdersSearchPlaceholder"]"
               aria-label="@L["Catalog.SearchLabel"]" />
        <div class="admin-toolbar-btns">
            <button type="submit" class="btn btn-primary btn-sm">@L["Admin.ApplyFilter"]</button>
            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Orders" asp-action="Index">@L["Admin.ResetFilters"]</a>
        </div>
    </div>
</form>

<section class="panel-card admin-section-card">
    @if (Model.Orders.Count == 0)
    {
        <div class="admin-empty-box">
            <p>@L["Admin.OrdersEmpty"]</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@L["Admin.ColOrderNumber"]</th>
                        <th>@L["Admin.ColCustomer"]</th>
                        <th>@L["Admin.ColDate"]</th>
                        <th>@L["Admin.ColItems"]</th>
                        <th>@L["Admin.ColStatus"]</th>
                        <th class="text-right">@L["Admin.ColTotal"]</th>
                        <th class="text-right">@L["Admin.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>
                                <a class="table-primary-link mono" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">
                                    @order.OrderNumber
                                </a>
                            </td>
                            <td>
                                <div class="table-primary-text">@order.CustomerName</div>
                                <div class="table-secondary-text mono">@order.CustomerEmail</div>
                            </td>
                            <td class="mono">
                                <div>@order.CreatedAtUtc.ToString("yyyy-MM-dd")</div>
                                <div class="table-secondary-text">@order.CreatedAtUtc.ToString("HH:mm") UTC</div>
                            </td>
                            <td class="mono">@L["Orders.ItemsSummary", order.ItemCount]</td>
                            <td>
                                <span class="badge @AdminHelpers.GetOrderBadgeClass(order.Status)">
                                    <span class="status-dot" aria-hidden="true"></span>
                                    @L[order.Status.GetStatusResourceKey()]
                                </span>
                            </td>
                            <td class="text-right mono">
                                <strong>@order.FormattedTotal</strong>
                            </td>
                            <td class="text-right">
                                <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">
                                    @L["Admin.InspectOrder"] →
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="@L["Catalog.PaginationLabel"]">
                <span class="table-secondary-text mono">@L["Catalog.PageOf", Model.Page, Model.TotalPages]</span>
                <div class="pagination-pages">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-secondary btn-sm"
                           asp-area="Admin"
                           asp-controller="Orders"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-page="@(Model.Page - 1)">← @L["Catalog.Previous"]</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn btn-secondary btn-sm"
                           asp-area="Admin"
                           asp-controller="Orders"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-page="@(Model.Page + 1)">@L["Catalog.Next"] →</a>
                    }
                </div>
            </nav>
        }
    }
</section>
