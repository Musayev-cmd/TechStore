@model AdminCustomerListViewModel

<div class="admin-page-head">
    <div>
        <h1 class="admin-page-title">@L["Admin.CustomersTitle"]</h1>
        <p class="admin-page-subtitle">@L["Admin.CustomersSubtitle"]</p>
    </div>
    <div class="admin-head-actions">
        <span class="badge badge-neutral mono">@L["Admin.TotalRecords", Model.TotalCount]</span>
    </div>
</div>

<form class="panel-card admin-toolbar" method="get" asp-area="Admin" asp-controller="Customers" asp-action="Index">
    <div class="admin-toolbar-search-row">
        <input type="search"
               name="search"
               value="@Model.Search"
               class="input input-sm"
               placeholder="@L["Admin.CustomersSearchPlaceholder"]"
               aria-label="@L["Catalog.SearchLabel"]" />
        <div class="admin-toolbar-btns">
            <button type="submit" class="btn btn-primary btn-sm">@L["Admin.ApplyFilter"]</button>
            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Customers" asp-action="Index">@L["Admin.ResetFilters"]</a>
        </div>
    </div>
</form>

<section class="panel-card admin-section-card">
    @if (Model.Customers.Count == 0)
    {
        <div class="admin-empty-box">
            <p>@L["Admin.CustomersEmpty"]</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@L["Admin.ColCustomer"]</th>
                        <th>@L["Admin.ColRole"]</th>
                        <th>@L["Admin.ColLocation"]</th>
                        <th>@L["Admin.ColLanguage"]</th>
                        <th>@L["Admin.ColOrders"]</th>
                        <th class="text-right">@L["Admin.ColTotalSpent"]</th>
                        <th>@L["Admin.ColJoined"]</th>
                        <th class="text-right">@L["Admin.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.Customers)
                    {
                        var location = string.Join(", ", new[] { customer.City, customer.Country }.Where(x => !string.IsNullOrWhiteSpace(x)));
                        <tr>
                            <td>
                                <div class="table-primary-text">@customer.FullName</div>
                                <div class="table-secondary-text mono">@customer.Email</div>
                                @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
                                {
                                    <div class="table-secondary-text mono">@customer.PhoneNumber</div>
                                }
                            </td>
                            <td>
                                @if (customer.IsAdmin)
                                {
                                    <span class="badge badge-accent">@L["Admin.RoleAdmin"]</span>
                                }
                                else
                                {
                                    <span class="badge badge-neutral">@L["Admin.RoleCustomer"]</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(location) ? "—" : location)</td>
                            <td class="mono">@customer.PreferredLanguage.ToUpperInvariant()</td>
                            <td class="mono">@customer.OrdersCount</td>
                            <td class="text-right mono"><strong>@customer.FormattedTotalSpent</strong></td>
                            <td class="mono">@customer.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                            <td class="text-right">
                                <a class="btn btn-secondary btn-sm"
                                   asp-area="Admin"
                                   asp-controller="Orders"
                                   asp-action="Index"
                                   asp-route-search="@customer.Email">
                                    @L["Admin.ViewCustomerOrders"] →
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="@L["Catalog.PaginationLabel"]">
                <span class="table-secondary-text mono">@L["Catalog.PageOf", Model.Page, Model.TotalPages]</span>
                <div class="pagination-pages">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-secondary btn-sm"
                           asp-area="Admin"
                           asp-controller="Customers"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Page - 1)">← @L["Catalog.Previous"]</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn btn-secondary btn-sm"
                           asp-area="Admin"
                           asp-controller="Customers"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-page="@(Model.Page + 1)">@L["Catalog.Next"] →</a>
                    }
                </div>
            </nav>
        }
    }
</section>
