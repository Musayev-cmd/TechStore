@model AdminProductListViewModel

<div class="admin-page-head">
    <div>
        <h1 class="admin-page-title">@L["Admin.ProductsTitle"]</h1>
        <p class="admin-page-subtitle">@L["Admin.ProductsSubtitle"]</p>
    </div>
    <div class="admin-head-actions">
        <span class="badge badge-neutral mono">@L["Admin.TotalRecords", Model.TotalCount]</span>
        <a class="btn btn-primary btn-sm" asp-area="Admin" asp-controller="Products" asp-action="Create">
            + @L["Admin.AddProduct"]
        </a>
    </div>
</div>

<form class="panel-card admin-toolbar" method="get" asp-area="Admin" asp-controller="Products" asp-action="Index">
    <div class="admin-toolbar-grid">
        <input type="search"
               name="search"
               value="@Model.Search"
               class="input input-sm"
               placeholder="@L["Admin.ProductsSearchPlaceholder"]"
               aria-label="@L["Catalog.SearchLabel"]" />

        <select name="categoryId" class="select input-sm" aria-label="@L["Admin.ColCategory"]">
            <option value="">@L["Catalog.AllCategories"]</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
            }
        </select>

        <select name="stock" class="select input-sm" aria-label="@L["Admin.ColStock"]">
            <option value="all" selected="@(Model.StockFilter == "all" ? "selected" : null)">@L["Admin.FilterAllStock"]</option>
            <option value="in-stock" selected="@(Model.StockFilter == "in-stock" ? "selected" : null)">@L["Admin.FilterInStock"]</option>
            <option value="low-stock" selected="@(Model.StockFilter == "low-stock" ? "selected" : null)">@L["Admin.FilterLowStock"]</option>
            <option value="out-of-stock" selected="@(Model.StockFilter == "out-of-stock" ? "selected" : null)">@L["Admin.FilterOutOfStock"]</option>
        </select>

        <select name="status" class="select input-sm" aria-label="@L["Admin.ColStatus"]">
            <option value="all" selected="@(Model.StatusFilter == "all" ? "selected" : null)">@L["Admin.FilterAllStatus"]</option>
            <option value="active" selected="@(Model.StatusFilter == "active" ? "selected" : null)">@L["Admin.FilterActive"]</option>
            <option value="inactive" selected="@(Model.StatusFilter == "inactive" ? "selected" : null)">@L["Admin.FilterInactive"]</option>
        </select>

        <div class="admin-toolbar-btns">
            <button type="submit" class="btn btn-primary btn-sm">@L["Admin.ApplyFilter"]</button>
            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Products" asp-action="Index">@L["Admin.ResetFilters"]</a>
        </div>
    </div>
</form>

<section class="panel-card admin-section-card">
    @if (Model.Products.Count == 0)
    {
        <div class="admin-empty-box">
            <p>@L["Admin.ProductsEmpty"]</p>
            <a class="btn btn-primary btn-sm" asp-area="Admin" asp-controller="Products" asp-action="Create">+ @L["Admin.AddProduct"]</a>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@L["Admin.ColProduct"]</th>
                        <th>@L["Admin.ColCategory"]</th>
                        <th>@L["Admin.ColPrice"]</th>
                        <th>@L["Admin.ColStock"]</th>
                        <th>@L["Admin.ColStatus"]</th>
                        <th class="text-right">@L["Admin.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class="table-product-cell">
                                    <div class="table-thumb">
                                        @if (!string.IsNullOrWhiteSpace(product.PrimaryImageUrl))
                                        {
                                            <img src="@product.PrimaryImageUrl" alt="@product.Name" loading="lazy" />
                                        }
                                    </div>
                                    <div class="table-product-meta">
                                        <a class="table-primary-link" asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">@product.Name</a>
                                        <span class="table-secondary-text mono">@product.Brand · @product.Sku</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-neutral">@product.CategoryName</span>
                            </td>
                            <td class="mono">
                                @if (!string.IsNullOrWhiteSpace(product.FormattedDiscountPrice))
                                {
                                    <div class="table-price-discount">@product.FormattedDiscountPrice</div>
                                    <div class="table-price-old">@product.FormattedPrice</div>
                                }
                                else
                                {
                                    <div class="table-primary-text">@product.FormattedPrice</div>
                                }
                            </td>
                            <td>
                                @if (product.IsOutOfStock)
                                {
                                    <span class="badge badge-danger">
                                        <span class="status-dot" aria-hidden="true"></span>
                                        @L["Stock.OutOfStock"]
                                    </span>
                                }
                                else if (product.IsLowStock)
                                {
                                    <span class="badge badge-warning">
                                        <span class="status-dot" aria-hidden="true"></span>
                                        @L["Stock.LowStock", product.StockQuantity]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-success">
                                        <span class="status-dot" aria-hidden="true"></span>
                                        @product.StockQuantity
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="table-badge-stack">
                                    @if (product.IsActive)
                                    {
                                        <span class="badge badge-success">@L["Admin.StatusActive"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-neutral">@L["Admin.StatusInactive"]</span>
                                    }
                                    @if (product.IsFeatured)
                                    {
                                        <span class="badge badge-accent">@L["Admin.StatusFeatured"]</span>
                                    }
                                </div>
                            </td>
                            <td class="text-right">
                                <div class="table-actions">
                                    @if (product.IsActive)
                                    {
                                        <a class="btn btn-ghost btn-sm" href="/Catalog/Details/@product.Slug" target="_blank" rel="noopener">
                                            @L["Admin.ViewInStore"]
                                        </a>
                                    }
                                    <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id">
                                        @L["Common.Edit"]
                                    </a>
                                    <form method="post"
                                          asp-area="Admin"
                                          asp-controller="Products"
                                          asp-action="Delete"
                                          asp-route-id="@product.Id"
                                          data-confirm-form
                                          data-confirm-message="@L["Admin.DeleteProductConfirm", product.Name]">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">@L["Common.Delete"]</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-bar" aria-label="@L["Catalog.PaginationLabel"]">
                <span class="table-secondary-text mono">@L["Catalog.PageOf", Model.Page, Model.TotalPages]</span>
                <div class="pagination-pages">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-secondary btn-sm"
                           asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-stock="@Model.StockFilter"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-page="@(Model.Page - 1)">← @L["Catalog.Previous"]</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="btn btn-secondary btn-sm"
                           asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-stock="@Model.StockFilter"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-page="@(Model.Page + 1)">@L["Catalog.Next"] →</a>
                    }
                </div>
            </nav>
        }
    }
</section>
