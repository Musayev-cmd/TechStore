@model AdminProductFormViewModel

<div class="admin-page-head">
    <div>
        <h1 class="admin-page-title">@L["Admin.ProductCreateTitle"]</h1>
        <p class="admin-page-subtitle">@L["Admin.ProductCreateSubtitle"]</p>
    </div>
    <div class="admin-head-actions">
        <a class="btn btn-secondary btn-sm" asp-area="Admin" asp-controller="Products" asp-action="Index">
            ← @L["Admin.BackToProducts"]
        </a>
    </div>
</div>

@await Html.PartialAsync("_ProductForm", Model)
