# Copy this file to .env and fill in strong, unique values before running Docker Compose.
# Never commit .env to version control (.env is excluded in .gitignore).

# Application
ASPNETCORE_ENVIRONMENT=Production
APP_PORT=8080
DATABASE_AUTOMIGRATE=true

# PostgreSQL (required: set a strong password)
POSTGRES_DB=techstore
POSTGRES_USER=techstore
POSTGRES_PASSWORD=

# Initial Admin bootstrap (required on first start in Production; min 8 chars with upper, lower, digit, and symbol)
SEED_ADMIN_EMAIL=admin@techstore.local
SEED_ADMIN_FULLNAME=TechStore Administrator
SEED_ADMIN_PASSWORD=

# Stripe Checkout & Webhooks (optional to browse catalog; required for live/test payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
