@model CheckoutViewModel

<section class="page-banner">
    <div class="container">
        <nav class="breadcrumbs" aria-label="@L["Product.BreadcrumbLabel"]">
            <a asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <a asp-controller="Cart" asp-action="Index">@L["Cart.Title"]</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <span aria-current="page">@L["Checkout.Title"]</span>
        </nav>

        <div class="page-banner-head">
            <div>
                <h1 class="page-banner-title">@L["Checkout.Title"]</h1>
                <p class="page-banner-subtitle">@L["Checkout.Subtitle"]</p>
            </div>
            <a class="btn btn-secondary btn-sm" asp-controller="Cart" asp-action="Index">
                ← @L["Checkout.BackToCart"]
            </a>
        </div>
    </div>
</section>

<section class="section checkout-section">
    <div class="container">
        @if (!Model.IsAuthenticated)
        {
            <div class="alert alert-info checkout-guest-banner">
                <span>@L["Checkout.GuestPrompt"]</span>
                <a class="alert-link" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Checkout">
                    @L["Checkout.GuestSignIn"] →
                </a>
            </div>
        }

        @if (!Model.StripeConfigured)
        {
            <div class="alert alert-warning" role="alert">
                <span>@L["Checkout.StripeNotConfigured"]</span>
            </div>
        }

        <div class="checkout-grid">
            <form class="checkout-form-card" asp-controller="Checkout" asp-action="Index" method="post" novalidate>
                @Html.AntiForgeryToken()

                <h2 class="panel-heading">@L["Checkout.ShippingDetails"]</h2>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="form-grid">
                    <div class="form-field form-field-full">
                        <label class="field-label" asp-for="Input.CustomerName">@L["Checkout.FullName"]</label>
                        <input class="input" asp-for="Input.CustomerName" autocomplete="name" placeholder="@L["Checkout.FullNamePlaceholder"]" />
                        <span class="field-error" asp-validation-for="Input.CustomerName"></span>
                    </div>

                    <div class="form-field">
                        <label class="field-label" asp-for="Input.CustomerEmail">@L["Checkout.Email"]</label>
                        <input class="input" asp-for="Input.CustomerEmail" type="email" autocomplete="email" placeholder="@L["Checkout.EmailPlaceholder"]" />
                        <span class="field-error" asp-validation-for="Input.CustomerEmail"></span>
                    </div>

                    <div class="form-field">
                        <label class="field-label" asp-for="Input.CustomerPhone">@L["Checkout.Phone"]</label>
                        <input class="input" asp-for="Input.CustomerPhone" type="tel" autocomplete="tel" placeholder="@L["Checkout.PhonePlaceholder"]" />
                        <span class="field-error" asp-validation-for="Input.CustomerPhone"></span>
                    </div>

                    <div class="form-field form-field-full">
                        <label class="field-label" asp-for="Input.ShippingAddress">@L["Checkout.Address"]</label>
                        <input class="input" asp-for="Input.ShippingAddress" autocomplete="street-address" placeholder="@L["Checkout.AddressPlaceholder"]" />
                        <span class="field-error" asp-validation-for="Input.ShippingAddress"></span>
                    </div>

                    <div class="form-field">
                        <label class="field-label" asp-for="Input.ShippingCity">@L["Checkout.City"]</label>
                        <input class="input" asp-for="Input.ShippingCity" autocomplete="address-level2" placeholder="@L["Checkout.CityPlaceholder"]" />
                        <span class="field-error" asp-validation-for="Input.ShippingCity"></span>
                    </div>

                    <div class="form-field">
                        <label class="field-label" asp-for="Input.ShippingPostalCode">@L["Checkout.PostalCode"]</label>
                        <input class="input" asp-for="Input.ShippingPostalCode" autocomplete="postal-code" placeholder="@L["Checkout.PostalCodePlaceholder"]" />
                        <span class="field-error" asp-validation-for="Input.ShippingPostalCode"></span>
                    </div>

                    <div class="form-field form-field-full">
                        <label class="field-label" asp-for="Input.ShippingCountry">@L["Checkout.Country"]</label>
                        <input class="input" asp-for="Input.ShippingCountry" autocomplete="country-name" placeholder="@L["Checkout.CountryPlaceholder"]" />
                        <span class="field-error" asp-validation-for="Input.ShippingCountry"></span>
                    </div>

                    <div class="form-field form-field-full">
                        <label class="field-label" asp-for="Input.Notes">@L["Checkout.Notes"]</label>
                        <textarea class="textarea" asp-for="Input.Notes" rows="3" placeholder="@L["Checkout.NotesPlaceholder"]"></textarea>
                        <span class="field-error" asp-validation-for="Input.Notes"></span>
                    </div>

                    @if (Model.IsAuthenticated)
                    {
                        <div class="form-field form-field-full">
                            <label class="checkbox-row">
                                <input type="checkbox" asp-for="Input.SaveAddressToProfile" />
                                <span>@L["Checkout.SaveAddress"]</span>
                            </label>
                        </div>
                    }
                </div>

                <div class="checkout-submit-block">
                    <button type="submit" class="btn btn-primary btn-lg checkout-submit-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                            <line x1="2" y1="10" x2="22" y2="10"></line>
                        </svg>
                        <span>@L["Checkout.PayWithStripe"] — @Model.Cart.FormattedTotal</span>
                    </button>
                    <p class="checkout-secure-note">@L["Checkout.SecureNotice"]</p>
                </div>
            </form>

            <aside class="summary-card checkout-summary">
                <h2 class="summary-card-title">@L["Checkout.OrderSummary"]</h2>

                <ul class="checkout-items-list">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <li class="checkout-item-row">
                            <div class="checkout-item-thumb">
                                <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                <span class="checkout-item-qty mono">@item.Quantity</span>
                            </div>
                            <div class="checkout-item-info">
                                <div class="checkout-item-name">@item.Name</div>
                                <div class="checkout-item-sku mono">@item.Sku</div>
                            </div>
                            <div class="checkout-item-price mono">@item.FormattedLineTotal</div>
                        </li>
                    }
                </ul>

                <div class="summary-rows">
                    <div class="summary-row">
                        <span>@L["Cart.Subtotal"]</span>
                        <span class="mono">@Model.Cart.FormattedSubtotal</span>
                    </div>
                    <div class="summary-row">
                        <span>@L["Cart.Shipping"]</span>
                        <span class="mono @(Model.Cart.ShippingAmount == 0m ? "text-success" : "")">@Model.Cart.FormattedShipping</span>
                    </div>
                    <div class="summary-row is-total">
                        <span>@L["Cart.Total"]</span>
                        <strong class="mono">@Model.Cart.FormattedTotal</strong>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>
