@model CheckoutCancelViewModel

<section class="section">
    <div class="container">
        <div class="status-card">
            <div class="status-icon is-warning" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>

            <h1 class="status-card-title">@L["Checkout.CancelTitle"]</h1>
            <p class="status-card-desc">@L["Checkout.CancelSubtitle"]</p>

            @if (!string.IsNullOrWhiteSpace(Model.OrderNumber))
            {
                <div class="badge badge-neutral mono">@L["Checkout.OrderNumber"]: @Model.OrderNumber</div>
            }

            <div class="status-card-actions">
                @if (Model.CartItemCount > 0)
                {
                    <a class="btn btn-primary" asp-controller="Checkout" asp-action="Index">@L["Checkout.RetryCheckout"]</a>
                }
                <a class="btn btn-secondary" asp-controller="Cart" asp-action="Index">@L["Checkout.BackToCart"]</a>
                <a class="btn btn-ghost" asp-controller="Catalog" asp-action="Index">@L["Cart.ContinueShopping"]</a>
            </div>
        </div>
    </div>
</section>
