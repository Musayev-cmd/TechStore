@model ProductCardViewModel
<article class="product-card" data-product-id="@Model.Id">
    <a class="product-card-media" href="@Model.Url">
        <img src="@Model.ImageUrl" alt="@Model.ImageAlt" loading="lazy" />
        <div class="product-card-badges">
            @if (Model.HasDiscount)
            {
                <span class="badge badge-accent">@L["Product.SavePercent", Model.DiscountPercent]</span>
            }
            else
            {
                <span></span>
            }

            @if (Model.StockState == "out_of_stock")
            {
                <span class="badge badge-danger">@L["Stock.OutOfStock"]</span>
            }
            else if (Model.StockState == "low_stock")
            {
                <span class="badge badge-warning">@L["Stock.LowStock", Model.StockQuantity]</span>
            }
            else
            {
                <span class="badge badge-success">@L["Stock.InStock"]</span>
            }
        </div>
    </a>

    <div class="product-card-body">
        <div class="product-card-meta">
            <span>@Model.Brand</span>
            <span>@Model.CategoryName</span>
        </div>
        <h3 class="product-card-title">
            <a href="@Model.Url">@Model.Name</a>
        </h3>
        <p class="product-card-desc">@Model.ShortDescription</p>

        <div class="product-card-footer">
            <div class="price-stack">
                @if (Model.HasDiscount)
                {
                    <span class="price-old">@Model.FormattedPrice</span>
                }
                <span class="price-current">@Model.FormattedEffectivePrice</span>
            </div>
            <div class="product-card-actions">
                <a class="btn btn-secondary btn-sm" href="@Model.Url">
                    @L["Catalog.ViewDetails"]
                </a>
                <button type="button"
                        class="btn-icon btn-card-cart"
                        data-quick-add-to-cart
                        data-product-id="@Model.Id"
                        aria-label="@L["Cart.QuickAdd"]"
                        title="@(Model.StockQuantity > 0 ? L["Cart.QuickAdd"].Value : L["Stock.OutOfStock"].Value)"
                        disabled="@(Model.StockQuantity <= 0)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</article>
