<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">TS</span>
                    <span>TechStore<span class="brand-dot">.</span></span>
                </a>
                <p class="footer-about">@L["Footer.AboutText"]</p>
            </div>

            <div>
                <h2 class="footer-heading">@L["Footer.ShopHeading"]</h2>
                <ul class="footer-links">
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a></li>
                    <li><a href="/Catalog">@L["Nav.Catalog"]</a></li>
                    <li><a href="/#categories">@L["Nav.Categories"]</a></li>
                    <li><a href="/Cart">@L["Nav.Cart"]</a></li>
                </ul>
            </div>

            <div>
                <h2 class="footer-heading">@L["Footer.AccountHeading"]</h2>
                <ul class="footer-links">
                    <li><a href="/Account/Profile">@L["Nav.Profile"]</a></li>
                    <li><a href="/Account/Orders">@L["Nav.Orders"]</a></li>
                    <li><a href="/Account/Login">@L["Nav.SignIn"]</a></li>
                    <li><a href="/Account/Register">@L["Nav.Register"]</a></li>
                </ul>
            </div>

            <div>
                <h2 class="footer-heading">@L["Footer.SupportHeading"]</h2>
                <ul class="footer-links">
                    <li>@L["Footer.Location"]</li>
                    <li class="mono">@L["Footer.CurrencyNote", Currency.CurrencyCode, Currency.CurrencySymbol]</li>
                    <li>support@techstore.local</li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; @DateTime.UtcNow.Year @L["Site.Name"]. @L["Footer.Rights"]</span>
            <span class="mono">@L["Site.Tagline"]</span>
        </div>
    </div>
</footer>
