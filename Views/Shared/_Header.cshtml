@using TechStore.Data
@{
    var currentCulture = LocalizationHelper.CurrentCultureCode();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentSearchQuery = Context.Request.Query["q"].FirstOrDefault()
        ?? Context.Request.Query["search"].FirstOrDefault()
        ?? string.Empty;
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path)
        ? "/"
        : $"{Context.Request.Path}{Context.Request.QueryString}";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole(DbSeeder.AdminRole);
}
<header class="site-header" data-site-header>
    <div class="container header-inner">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="@L["Site.Name"]">
            <span class="brand-mark" aria-hidden="true">TS</span>
            <span>TechStore<span class="brand-dot">.</span></span>
        </a>

        <nav class="header-nav" aria-label="@L["Nav.PrimaryNavLabel"]">
            <a class="nav-link @(currentController == "Home" ? "is-active" : "")"
               asp-area="" asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a>
            <a class="nav-link @(currentController == "Catalog" ? "is-active" : "")"
               asp-area="" asp-controller="Catalog" asp-action="Index">@L["Nav.Catalog"]</a>
            <a class="nav-link" href="/#categories">@L["Nav.Categories"]</a>
            @if (isAdmin)
            {
                <a class="nav-link" href="/Admin">@L["Nav.Admin"]</a>
            }
        </nav>

        <form class="header-search" action="/Catalog" method="get" role="search">
            <svg class="header-search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="search"
                   name="q"
                   value="@currentSearchQuery"
                   class="header-search-input"
                   placeholder="@L["Nav.SearchPlaceholder"]"
                   aria-label="@L["Catalog.SearchLabel"]" />
            <button type="submit" class="header-search-btn" aria-label="@L["Nav.SearchSubmit"]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <div class="header-actions">
            <div class="lang-switcher" role="group" aria-label="@L["Language.Label"]">
                @foreach (var lang in JsonLocalizationStore.SupportedCultures)
                {
                    var labelKey = lang switch
                    {
                        "ru" => "Language.Ru",
                        "az" => "Language.Az",
                        _ => "Language.En"
                    };
                    <form class="lang-form" asp-area="" asp-controller="Localization" asp-action="SetLanguage" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="culture" value="@lang" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit"
                                class="lang-btn @(currentCulture == lang ? "is-active" : "")"
                                aria-pressed="@(currentCulture == lang ? "true" : "false")">
                            @L[labelKey]
                        </button>
                    </form>
                }
            </div>

            <button type="button"
                    class="btn-icon theme-toggle"
                    data-theme-toggle
                    aria-label="@L["Theme.Toggle"]"
                    title="@L["Theme.Toggle"]">
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                </svg>
            </button>

            <button type="button"
                    class="btn-icon cart-trigger"
                    data-drawer-open="cart"
                    aria-expanded="false"
                    aria-controls="cart-drawer"
                    aria-label="@L["Nav.Cart"]"
                    title="@L["Nav.Cart"]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span class="cart-badge is-empty" data-cart-badge>0</span>
            </button>

            <div class="header-account-links">
                @if (isAuthenticated)
                {
                    <a class="btn btn-ghost btn-sm" href="/Account/Profile">@L["Nav.Account"]</a>
                    <form method="post" action="/Account/Logout" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary btn-sm">@L["Nav.SignOut"]</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-ghost btn-sm" href="/Account/Login">@L["Nav.SignIn"]</a>
                    <a class="btn btn-primary btn-sm" href="/Account/Register">@L["Nav.Register"]</a>
                }
            </div>

            <button type="button"
                    class="btn-icon mobile-menu-trigger"
                    data-drawer-open="mobile-nav"
                    aria-expanded="false"
                    aria-controls="mobile-nav-drawer"
                    aria-label="@L["Nav.Menu"]">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <line x1="4" y1="7" x2="20" y2="7"></line>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <line x1="4" y1="17" x2="20" y2="17"></line>
                </svg>
            </button>
        </div>
    </div>
</header>

<aside id="mobile-nav-drawer" class="mobile-drawer" data-drawer="mobile-nav" aria-hidden="true" aria-label="@L["Nav.Menu"]">
    <div class="mobile-drawer-header">
        <span class="brand">
            <span class="brand-mark" aria-hidden="true">TS</span>
            <span>TechStore<span class="brand-dot">.</span></span>
        </span>
        <button type="button" class="btn-icon" data-drawer-close aria-label="@L["Common.Close"]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <form class="mobile-search-form" action="/Catalog" method="get" role="search">
        <input type="search"
               name="q"
               value="@currentSearchQuery"
               class="input"
               placeholder="@L["Catalog.SearchPlaceholder"]"
               aria-label="@L["Catalog.SearchLabel"]" />
    </form>

    <nav class="mobile-nav-list" aria-label="@L["Nav.MobileNavLabel"]">
        <a class="mobile-nav-link" asp-area="" asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a>
        <a class="mobile-nav-link" asp-area="" asp-controller="Catalog" asp-action="Index">@L["Nav.Catalog"]</a>
        <a class="mobile-nav-link" href="/#categories">@L["Nav.Categories"]</a>
        <a class="mobile-nav-link" href="/Cart">@L["Nav.Cart"]</a>
        @if (isAuthenticated)
        {
            <a class="mobile-nav-link" href="/Account/Profile">@L["Nav.Profile"]</a>
            <a class="mobile-nav-link" href="/Account/Orders">@L["Nav.Orders"]</a>
        }
        @if (isAdmin)
        {
            <a class="mobile-nav-link" href="/Admin">@L["Nav.Admin"]</a>
        }
    </nav>

    <div class="mobile-drawer-footer">
        @if (isAuthenticated)
        {
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-secondary" style="width:100%;">@L["Nav.SignOut"]</button>
            </form>
        }
        else
        {
            <a class="btn btn-secondary" href="/Account/Login" style="width:100%;">@L["Nav.SignIn"]</a>
            <a class="btn btn-primary" href="/Account/Register" style="width:100%;">@L["Nav.Register"]</a>
        }
    </div>
</aside>
