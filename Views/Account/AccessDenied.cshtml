<section class="section">
    <div class="container">
        <div class="status-card">
            <div class="status-icon is-danger" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <h1 class="status-card-title">@L["Account.AccessDeniedTitle"]</h1>
            <p class="status-card-desc">@L["Account.AccessDeniedSubtitle"]</p>
            <div class="status-card-actions">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@L["Error.BackHome"]</a>
                <a class="btn btn-secondary" asp-controller="Account" asp-action="Login">@L["Account.SignInDifferent"]</a>
            </div>
        </div>
    </div>
</section>
