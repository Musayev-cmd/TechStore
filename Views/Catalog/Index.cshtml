@using System.Text.Json
@model CatalogSearchResultViewModel
@{
    ViewData["Title"] = !string.IsNullOrWhiteSpace(Model.ActiveFilters.CategoryName)
        ? $"{Model.ActiveFilters.CategoryName} — {L["Catalog.Title"]}"
        : L["Catalog.Title"].Value;

    var active = Model.ActiveFilters;
    var selectedBrandsSet = new HashSet<string>(active.Brands, StringComparer.OrdinalIgnoreCase);

    var initialStateJson = JsonSerializer.Serialize(new
    {
        search = active.Search ?? string.Empty,
        category = active.Category ?? string.Empty,
        categoryName = active.CategoryName ?? string.Empty,
        brands = active.Brands,
        minPrice = active.MinPrice,
        maxPrice = active.MaxPrice,
        inStock = active.InStockOnly,
        deals = active.DealsOnly,
        featured = active.FeaturedOnly,
        sort = Model.Sort,
        page = Model.Page,
        pageSize = Model.PageSize,
        totalCount = Model.TotalCount,
        totalPages = Model.TotalPages,
        lowStockThreshold = Model.LowStockThreshold,
        priceBounds = new { min = Model.Facets.PriceBounds.Min, max = Model.Facets.PriceBounds.Max }
    });
}
@functions {
    private string BuildCatalogUrl(int targetPage)
    {
        var active = Model.ActiveFilters;
        var pairs = new List<string>();

        if (!string.IsNullOrWhiteSpace(active.Search))
            pairs.Add($"q={Uri.EscapeDataString(active.Search)}");
        if (!string.IsNullOrWhiteSpace(active.Category))
            pairs.Add($"category={Uri.EscapeDataString(active.Category)}");
        if (active.Brands.Count > 0)
            pairs.Add($"brand={Uri.EscapeDataString(string.Join(",", active.Brands))}");
        if (active.MinPrice.HasValue)
            pairs.Add($"minPrice={active.MinPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
        if (active.MaxPrice.HasValue)
            pairs.Add($"maxPrice={active.MaxPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
        if (active.InStockOnly)
            pairs.Add("inStock=true");
        if (active.DealsOnly)
            pairs.Add("deals=true");
        if (active.FeaturedOnly)
            pairs.Add("featured=true");
        if (!string.Equals(Model.Sort, "featured", StringComparison.OrdinalIgnoreCase))
            pairs.Add($"sort={Uri.EscapeDataString(Model.Sort)}");
        if (targetPage > 1)
            pairs.Add($"page={targetPage}");

        return pairs.Count == 0 ? "/Catalog" : $"/Catalog?{string.Join("&", pairs)}";
    }
}

<section class="page-banner">
    <div class="container">
        <nav class="breadcrumbs"
             aria-label="@L["Product.BreadcrumbLabel"]"
             data-catalog-breadcrumbs
             data-home-label="@L["Nav.Home"]"
             data-catalog-label="@L["Nav.Catalog"]">
            <a asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            @if (!string.IsNullOrWhiteSpace(active.CategoryName))
            {
                <a asp-controller="Catalog" asp-action="Index">@L["Nav.Catalog"]</a>
                <span class="breadcrumb-sep" aria-hidden="true">/</span>
                <span aria-current="page">@active.CategoryName</span>
            }
            else
            {
                <span aria-current="page">@L["Nav.Catalog"]</span>
            }
        </nav>

        <div class="page-banner-head">
            <div>
                <h1 class="page-banner-title">@L["Catalog.Title"]</h1>
                <p class="page-banner-subtitle">@L["Catalog.Subtitle"]</p>
            </div>
        </div>
    </div>
</section>

<section class="section catalog-section">
    <div class="container">
        <div class="catalog-layout" data-catalog-root data-initial-state="@initialStateJson">
            <aside id="catalog-filters"
                   class="catalog-sidebar"
                   data-drawer="catalog-filters"
                   data-drawer-mobile-only="true"
                   aria-label="@L["Catalog.Filters"]">
                <div class="catalog-sidebar-mobile-head">
                    <h2 class="catalog-sidebar-title">@L["Catalog.Filters"]</h2>
                    <button type="button" class="btn-icon" data-drawer-close aria-label="@L["Common.Close"]">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <form id="catalog-filter-form" class="filter-form" action="/Catalog" method="get" data-catalog-form>
                    <div class="filter-group">
                        <label class="filter-heading" for="catalog-search-input">@L["Catalog.SearchLabel"]</label>
                        <div class="search-field">
                            <svg class="search-field-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input id="catalog-search-input"
                                   type="search"
                                   name="q"
                                   value="@active.Search"
                                   class="input search-field-input"
                                   placeholder="@L["Catalog.SearchPlaceholder"]"
                                   autocomplete="off"
                                   data-filter-search />
                            <button type="button"
                                    class="search-field-clear"
                                    data-search-clear
                                    aria-label="@L["Catalog.ClearSearch"]"
                                    @(string.IsNullOrWhiteSpace(active.Search) ? "hidden" : null)>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <fieldset class="filter-group">
                        <legend class="filter-heading">@L["Catalog.FilterCategory"]</legend>
                        <div class="filter-list" data-filter-categories>
                            <label class="filter-option @(string.IsNullOrWhiteSpace(active.Category) ? "is-selected" : "")">
                                <input type="radio"
                                       name="category"
                                       value=""
                                       checked="@(string.IsNullOrWhiteSpace(active.Category))"
                                       data-filter-category />
                                <span class="filter-option-label">@L["Catalog.AllCategories"]</span>
                                <span class="filter-option-count mono" data-category-all-count>@Model.Facets.Categories.Sum(c => c.ProductCount)</span>
                            </label>
                            @foreach (var cat in Model.Facets.Categories)
                            {
                                var isSelected = string.Equals(active.Category, cat.Slug, StringComparison.OrdinalIgnoreCase);
                                <label class="filter-option @(isSelected ? "is-selected" : "")">
                                    <input type="radio"
                                           name="category"
                                           value="@cat.Slug"
                                           checked="@isSelected"
                                           data-filter-category />
                                    <span class="filter-option-label">@cat.Name</span>
                                    <span class="filter-option-count mono" data-category-count="@cat.Slug">@cat.ProductCount</span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    <fieldset class="filter-group">
                        <legend class="filter-heading">@L["Catalog.FilterBrand"]</legend>
                        <div class="filter-list filter-list-scroll" data-filter-brands>
                            @foreach (var brand in Model.Facets.Brands)
                            {
                                var isChecked = selectedBrandsSet.Contains(brand.Name);
                                <label class="filter-check @(isChecked ? "is-selected" : "")">
                                    <input type="checkbox"
                                           name="brand"
                                           value="@brand.Name"
                                           checked="@isChecked"
                                           data-filter-brand />
                                    <span class="filter-check-box" aria-hidden="true"></span>
                                    <span class="filter-option-label">@brand.Name</span>
                                    <span class="filter-option-count mono">@brand.ProductCount</span>
                                </label>
                            }
                        </div>
                    </fieldset>

                    <fieldset class="filter-group">
                        <legend class="filter-heading">@L["Catalog.FilterPrice"] (@Currency.CurrencySymbol)</legend>
                        <div class="price-range-row">
                            <div class="price-input-wrap">
                                <label class="sr-only" for="filter-min-price">@L["Catalog.MinPrice"]</label>
                                <input id="filter-min-price"
                                       type="number"
                                       name="minPrice"
                                       min="0"
                                       step="1"
                                       inputmode="decimal"
                                       value="@(active.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                       placeholder="@(Model.Facets.PriceBounds.Min > 0 ? Model.Facets.PriceBounds.Min.ToString("0") : L["Catalog.MinPrice"].Value)"
                                       class="input input-sm mono"
                                       data-filter-min-price />
                            </div>
                            <span class="price-range-sep" aria-hidden="true">–</span>
                            <div class="price-input-wrap">
                                <label class="sr-only" for="filter-max-price">@L["Catalog.MaxPrice"]</label>
                                <input id="filter-max-price"
                                       type="number"
                                       name="maxPrice"
                                       min="0"
                                       step="1"
                                       inputmode="decimal"
                                       value="@(active.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                       placeholder="@(Model.Facets.PriceBounds.Max > 0 ? Model.Facets.PriceBounds.Max.ToString("0") : L["Catalog.MaxPrice"].Value)"
                                       class="input input-sm mono"
                                       data-filter-max-price />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-secondary btn-sm filter-apply-btn" data-price-apply>
                            @L["Catalog.ApplyFilters"]
                        </button>
                    </fieldset>

                    <div class="filter-group filter-toggles">
                        <label class="toggle-row">
                            <input type="checkbox"
                                   name="inStock"
                                   value="true"
                                   checked="@active.InStockOnly"
                                   data-filter-instock />
                            <span class="toggle-track" aria-hidden="true"></span>
                            <span class="toggle-label">@L["Catalog.InStockOnly"]</span>
                        </label>

                        <label class="toggle-row">
                            <input type="checkbox"
                                   name="deals"
                                   value="true"
                                   checked="@active.DealsOnly"
                                   data-filter-deals />
                            <span class="toggle-track" aria-hidden="true"></span>
                            <span class="toggle-label">@L["Catalog.DealsOnly"]</span>
                        </label>
                    </div>

                    <div class="filter-sidebar-actions">
                        <button type="button"
                                class="btn btn-primary filter-mobile-apply"
                                data-drawer-close>
                            @L["Catalog.ShowResults"]
                        </button>
                        <button type="button"
                                class="btn btn-ghost btn-sm filter-clear-btn"
                                data-clear-filters
                                @(active.HasAnyFilter ? null : "hidden")>
                            @L["Catalog.ClearFilters"]
                        </button>
                    </div>
                </form>
            </aside>

            <div class="catalog-main">
                <div class="catalog-toolbar">
                    <div class="catalog-toolbar-left">
                        <button type="button"
                                class="btn btn-secondary btn-sm catalog-mobile-filter-btn"
                                data-drawer-open="catalog-filters"
                                aria-expanded="false"
                                aria-controls="catalog-filters">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="4" y1="21" x2="4" y2="14"></line>
                                <line x1="4" y1="10" x2="4" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12" y2="3"></line>
                                <line x1="20" y1="21" x2="20" y2="16"></line>
                                <line x1="20" y1="12" x2="20" y2="3"></line>
                                <line x1="1" y1="14" x2="7" y2="14"></line>
                                <line x1="9" y1="8" x2="15" y2="8"></line>
                                <line x1="17" y1="16" x2="23" y2="16"></line>
                            </svg>
                            <span>@L["Catalog.Filters"]</span>
                            <span class="filter-count-pill @(active.ActiveCount == 0 ? "is-empty" : "")" data-mobile-filter-count>@active.ActiveCount</span>
                        </button>

                        <p class="catalog-results-count mono" data-results-count aria-live="polite">
                            @L["Catalog.ResultsCount", Model.TotalCount]
                        </p>
                    </div>

                    <div class="catalog-toolbar-right">
                        <label class="catalog-sort-label" for="catalog-sort-select">@L["Catalog.SortBy"]</label>
                        <select id="catalog-sort-select" class="select catalog-sort-select" name="sort" data-filter-sort>
                            <option value="featured" selected="@(Model.Sort == "featured")">@L["Catalog.SortFeatured"]</option>
                            <option value="price_asc" selected="@(Model.Sort == "price_asc")">@L["Catalog.SortPriceAsc"]</option>
                            <option value="price_desc" selected="@(Model.Sort == "price_desc")">@L["Catalog.SortPriceDesc"]</option>
                            <option value="newest" selected="@(Model.Sort == "newest")">@L["Catalog.SortNewest"]</option>
                            <option value="name_asc" selected="@(Model.Sort == "name_asc")">@L["Catalog.SortNameAsc"]</option>
                        </select>
                    </div>
                </div>

                <div class="active-filters"
                     data-active-filters
                     aria-label="@L["Catalog.ActiveFilters"]"
                     @(active.HasAnyFilter ? null : "hidden")>
                    @if (!string.IsNullOrWhiteSpace(active.Search))
                    {
                        <button type="button" class="filter-chip" data-remove-filter="search">
                            <span>@L["Catalog.SearchChip", active.Search]</span>
                            <span class="filter-chip-x" aria-hidden="true">×</span>
                        </button>
                    }
                    @if (!string.IsNullOrWhiteSpace(active.Category))
                    {
                        <button type="button" class="filter-chip" data-remove-filter="category">
                            <span>@(active.CategoryName ?? active.Category)</span>
                            <span class="filter-chip-x" aria-hidden="true">×</span>
                        </button>
                    }
                    @foreach (var brand in active.Brands)
                    {
                        <button type="button" class="filter-chip" data-remove-filter="brand" data-filter-value="@brand">
                            <span>@brand</span>
                            <span class="filter-chip-x" aria-hidden="true">×</span>
                        </button>
                    }
                    @if (active.MinPrice.HasValue || active.MaxPrice.HasValue)
                    {
                        var priceLabel = active.MinPrice.HasValue && active.MaxPrice.HasValue
                            ? L["Catalog.PriceRangeChip", Currency.Format(active.MinPrice.Value), Currency.Format(active.MaxPrice.Value)].Value
                            : active.MinPrice.HasValue
                                ? L["Catalog.PriceMinChip", Currency.Format(active.MinPrice.Value)].Value
                                : L["Catalog.PriceMaxChip", Currency.Format(active.MaxPrice!.Value)].Value;
                        <button type="button" class="filter-chip" data-remove-filter="price">
                            <span>@priceLabel</span>
                            <span class="filter-chip-x" aria-hidden="true">×</span>
                        </button>
                    }
                    @if (active.InStockOnly)
                    {
                        <button type="button" class="filter-chip" data-remove-filter="inStock">
                            <span>@L["Catalog.InStockOnly"]</span>
                            <span class="filter-chip-x" aria-hidden="true">×</span>
                        </button>
                    }
                    @if (active.DealsOnly)
                    {
                        <button type="button" class="filter-chip" data-remove-filter="deals">
                            <span>@L["Catalog.DealsOnly"]</span>
                            <span class="filter-chip-x" aria-hidden="true">×</span>
                        </button>
                    }
                    <button type="button" class="filter-chip-clear" data-clear-filters>
                        @L["Catalog.ClearFilters"]
                    </button>
                </div>

                <div class="catalog-results-region" data-catalog-results aria-busy="false">
                    @if (Model.Items.Count > 0)
                    {
                        <div class="product-grid catalog-grid" data-catalog-grid>
                            @foreach (var product in Model.Items)
                            {
                                @await Html.PartialAsync("_ProductCard", product)
                            }
                        </div>
                    }
                    else
                    {
                        <div class="catalog-empty" data-catalog-empty>
                            <div class="catalog-empty-icon" aria-hidden="true">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    <line x1="8" y1="11" x2="14" y2="11"></line>
                                </svg>
                            </div>
                            <h2 class="catalog-empty-title">@L["Catalog.NoResultsTitle"]</h2>
                            <p class="catalog-empty-desc">@L["Catalog.NoResultsDesc"]</p>
                            <button type="button" class="btn btn-primary btn-sm" data-clear-filters>
                                @L["Catalog.ClearFilters"]
                            </button>
                        </div>
                    }
                </div>

                <nav class="pagination-bar"
                     data-catalog-pagination
                     aria-label="@L["Catalog.PaginationLabel"]"
                     @(Model.TotalPages > 1 ? null : "hidden")>
                    @if (Model.TotalPages > 1)
                    {
                        <a class="btn btn-secondary btn-sm pagination-btn @(Model.HasPrevious ? "" : "is-disabled")"
                           href="@(Model.HasPrevious ? BuildCatalogUrl(Model.Page - 1) : "#")"
                           data-page="@(Model.Page - 1)"
                           aria-disabled="@(!Model.HasPrevious ? "true" : "false")">
                            ← @L["Catalog.Previous"]
                        </a>

                        <div class="pagination-pages">
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <a class="pagination-page @(p == Model.Page ? "is-active" : "")"
                                   href="@BuildCatalogUrl(p)"
                                   data-page="@p"
                                   aria-current="@(p == Model.Page ? "page" : null)">
                                    @p
                                </a>
                            }
                        </div>

                        <a class="btn btn-secondary btn-sm pagination-btn @(Model.HasNext ? "" : "is-disabled")"
                           href="@(Model.HasNext ? BuildCatalogUrl(Model.Page + 1) : "#")"
                           data-page="@(Model.Page + 1)"
                           aria-disabled="@(!Model.HasNext ? "true" : "false")">
                            @L["Catalog.Next"] →
                        </a>
                    }
                </nav>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/catalog.js" asp-append-version="true" defer></script>
}
