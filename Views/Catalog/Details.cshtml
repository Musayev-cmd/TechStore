@model ProductDetailViewModel
@{
    var primaryImage = Model.Images.FirstOrDefault();
    var hasMultipleImages = Model.Images.Count > 1;
    var inStock = Model.StockQuantity > 0;
}

<section class="pdp-breadcrumb-bar">
    <div class="container">
        <nav class="breadcrumbs" aria-label="@L["Product.BreadcrumbLabel"]">
            <a asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <a asp-controller="Catalog" asp-action="Index">@L["Nav.Catalog"]</a>
            @if (!string.IsNullOrWhiteSpace(Model.CategorySlug))
            {
                <span class="breadcrumb-sep" aria-hidden="true">/</span>
                <a href="/Catalog?category=@Model.CategorySlug">@Model.CategoryName</a>
            }
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <span aria-current="page">@Model.Name</span>
        </nav>
    </div>
</section>

<section class="section pdp-section">
    <div class="container">
        <div class="pdp-grid">
            <div class="pdp-gallery" data-product-gallery aria-label="@L["Product.GalleryLabel"]">
                <div class="pdp-stage">
                    @if (primaryImage is not null)
                    {
                        <button type="button"
                                class="pdp-stage-trigger"
                                data-lightbox-open
                                aria-label="@L["Product.OpenLightbox"]">
                            <img src="@primaryImage.Url"
                                 alt="@primaryImage.AltText"
                                 class="pdp-main-image"
                                 data-gallery-main />
                        </button>
                    }

                    @if (Model.HasDiscount)
                    {
                        <span class="badge badge-accent pdp-stage-discount">
                            @L["Product.SavePercent", Model.DiscountPercent]
                        </span>
                    }

                    <button type="button"
                            class="btn-icon pdp-stage-expand"
                            data-lightbox-open
                            aria-label="@L["Product.OpenLightbox"]"
                            title="@L["Product.OpenLightbox"]">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <polyline points="9 21 3 21 3 15"></polyline>
                            <line x1="21" y1="3" x2="14" y2="10"></line>
                            <line x1="3" y1="21" x2="10" y2="14"></line>
                        </svg>
                    </button>

                    @if (hasMultipleImages)
                    {
                        <button type="button"
                                class="btn-icon pdp-stage-arrow is-prev"
                                data-gallery-prev
                                aria-label="@L["Product.PreviousImage"]">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                        </button>
                        <button type="button"
                                class="btn-icon pdp-stage-arrow is-next"
                                data-gallery-next
                                aria-label="@L["Product.NextImage"]">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </button>
                        <span class="pdp-stage-counter mono" data-gallery-counter>1 / @Model.Images.Count</span>
                    }
                </div>

                @if (hasMultipleImages)
                {
                    <div class="pdp-thumbs" role="list">
                        @for (var i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images[i];
                            <button type="button"
                                    class="pdp-thumb @(i == 0 ? "is-active" : "")"
                                    data-gallery-thumb
                                    data-index="@i"
                                    data-src="@img.Url"
                                    data-alt="@img.AltText"
                                    aria-pressed="@(i == 0 ? "true" : "false")"
                                    aria-label="@img.AltText">
                                <img src="@img.Url" alt="@img.AltText" loading="lazy" />
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="pdp-info">
                <div class="pdp-meta-row">
                    <a class="badge badge-neutral" href="/Catalog?brand=@Uri.EscapeDataString(Model.Brand)">@Model.Brand</a>
                    <a class="badge badge-neutral" href="/Catalog?category=@Model.CategorySlug">@Model.CategoryName</a>
                    <button type="button"
                            class="pdp-sku-btn mono"
                            data-copy-sku="@Model.Sku"
                            title="@L["Product.CopySku"]"
                            aria-label="@L["Product.CopySku"]">
                        <span>@L["Product.Sku"]: @Model.Sku</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                    </button>
                </div>

                <h1 class="pdp-title">@Model.Name</h1>

                <div class="pdp-stock-row">
                    @if (Model.StockState == "out_of_stock")
                    {
                        <span class="badge badge-danger">
                            <span class="status-dot" aria-hidden="true"></span>
                            @L["Stock.OutOfStock"]
                        </span>
                    }
                    else if (Model.StockState == "low_stock")
                    {
                        <span class="badge badge-warning">
                            <span class="status-dot" aria-hidden="true"></span>
                            @L["Stock.LowStock", Model.StockQuantity]
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-success">
                            <span class="status-dot" aria-hidden="true"></span>
                            @L["Stock.InStock"]
                        </span>
                        <span class="pdp-stock-units mono">@L["Product.InStockUnits", Model.StockQuantity]</span>
                    }
                </div>

                <p class="pdp-short-desc">@Model.ShortDescription</p>

                <div class="pdp-price-card">
                    <div class="pdp-price-main">
                        <span class="pdp-price-current mono">@Model.FormattedEffectivePrice</span>
                        @if (Model.HasDiscount)
                        {
                            <span class="pdp-price-old mono">@Model.FormattedPrice</span>
                        }
                    </div>
                    @if (Model.HasDiscount)
                    {
                        <div class="pdp-price-savings">
                            <span class="badge badge-accent">@L["Product.SavePercent", Model.DiscountPercent]</span>
                            <span class="pdp-savings-text">@L["Product.YouSave", Model.FormattedSavingsAmount]</span>
                        </div>
                    }
                </div>

                <div class="pdp-purchase-row">
                    <div class="qty-control" data-qty-stepper data-max="@Math.Max(1, Model.StockQuantity)">
                        <label class="sr-only" for="pdp-quantity">@L["Product.Quantity"]</label>
                        <button type="button"
                                class="qty-btn"
                                data-qty-dec
                                aria-label="@L["Product.DecreaseQty"]"
                                disabled="@(!inStock)">
                            −
                        </button>
                        <input id="pdp-quantity"
                               type="number"
                               class="qty-input mono"
                               value="1"
                               min="1"
                               max="@Math.Max(1, Model.StockQuantity)"
                               inputmode="numeric"
                               data-qty-input
                               disabled="@(!inStock)" />
                        <button type="button"
                                class="qty-btn"
                                data-qty-inc
                                aria-label="@L["Product.IncreaseQty"]"
                                disabled="@(!inStock || Model.StockQuantity <= 1)">
                            +
                        </button>
                    </div>

                    <button type="button"
                            class="btn btn-primary btn-lg pdp-add-btn"
                            data-add-to-cart
                            data-product-id="@Model.Id"
                            data-quantity="1"
                            disabled="@(!inStock)">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        <span>@(inStock ? L["Product.AddToCart"] : L["Stock.OutOfStock"])</span>
                    </button>
                </div>

                <ul class="pdp-assurances">
                    <li class="pdp-assurance-item">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="1" y="3" width="15" height="13"></rect>
                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                        <span>
                            @if (Model.QualifiesForFreeShipping)
                            {
                                @L["Product.FreeShippingEligible"]
                            }
                            else
                            {
                                @L["Product.ShippingInfo", Model.FormattedFlatShippingFee, Model.FormattedFreeShippingThreshold]
                            }
                        </span>
                    </li>
                    <li class="pdp-assurance-item">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                        <span>@L["Home.TrustWarrantyTitle"] — @L["Home.TrustWarrantyDesc"]</span>
                    </li>
                    <li class="pdp-assurance-item">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                            <line x1="2" y1="10" x2="22" y2="10"></line>
                        </svg>
                        <span>@L["Home.TrustPaymentTitle"]</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="pdp-details-grid">
            <section class="pdp-panel">
                <h2 class="pdp-panel-title">@L["Product.Overview"]</h2>
                <p class="pdp-description">@Model.Description</p>

                <dl class="pdp-key-facts">
                    <div class="pdp-fact">
                        <dt>@L["Product.Brand"]</dt>
                        <dd><a href="/Catalog?brand=@Uri.EscapeDataString(Model.Brand)">@Model.Brand</a></dd>
                    </div>
                    <div class="pdp-fact">
                        <dt>@L["Product.Category"]</dt>
                        <dd><a href="/Catalog?category=@Model.CategorySlug">@Model.CategoryName</a></dd>
                    </div>
                    <div class="pdp-fact">
                        <dt>@L["Product.Sku"]</dt>
                        <dd class="mono">@Model.Sku</dd>
                    </div>
                    <div class="pdp-fact">
                        <dt>@L["Product.Availability"]</dt>
                        <dd>
                            @(Model.StockState switch
                            {
                                "out_of_stock" => L["Stock.OutOfStock"].Value,
                                "low_stock" => L["Stock.LowStock", Model.StockQuantity].Value,
                                _ => L["Product.InStockUnits", Model.StockQuantity].Value
                            })
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="pdp-panel">
                <h2 class="pdp-panel-title">@L["Product.Specifications"]</h2>
                @if (Model.Specifications.Count > 0)
                {
                    <div class="spec-table-wrap">
                        <table class="spec-table">
                            <tbody>
                                @foreach (var spec in Model.Specifications)
                                {
                                    <tr>
                                        <th scope="row">@spec.Key</th>
                                        <td>@spec.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="pdp-empty-specs">@L["Product.NoSpecs"]</p>
                }
            </section>
        </div>
    </div>
</section>

@if (Model.RelatedProducts.Count > 0)
{
    <section class="section section-compact-top">
        <div class="container">
            <div class="section-header">
                <div>
                    <h2 class="section-title">@L["Product.RelatedProducts"]</h2>
                </div>
                <a class="btn btn-ghost btn-sm" href="/Catalog?category=@Model.CategorySlug">
                    @L["Product.ViewCategory", Model.CategoryName] →
                </a>
            </div>

            <div class="product-grid">
                @foreach (var related in Model.RelatedProducts)
                {
                    @await Html.PartialAsync("_ProductCard", related)
                }
            </div>
        </div>
    </section>
}

@if (Model.Images.Count > 0)
{
    <div class="lightbox-modal" data-lightbox role="dialog" aria-modal="true" aria-label="@L["Product.GalleryLabel"]" hidden>
        <div class="lightbox-backdrop" data-lightbox-close></div>
        <div class="lightbox-dialog">
            <div class="lightbox-topbar">
                <span class="lightbox-counter mono" data-lightbox-counter>1 / @Model.Images.Count</span>
                <div class="lightbox-controls">
                    <button type="button" class="btn-icon lightbox-btn" data-lightbox-zoom aria-pressed="false" aria-label="@L["Product.ZoomToggle"]" title="@L["Product.ZoomToggle"]">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            <line x1="11" y1="8" x2="11" y2="14"></line>
                            <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                    </button>
                    <button type="button" class="btn-icon lightbox-btn" data-lightbox-close aria-label="@L["Common.Close"]" title="@L["Common.Close"]">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="lightbox-stage">
                @if (hasMultipleImages)
                {
                    <button type="button" class="btn-icon lightbox-nav is-prev" data-lightbox-prev aria-label="@L["Product.PreviousImage"]">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                }

                <div class="lightbox-media-wrap" data-lightbox-media>
                    <img src="@primaryImage!.Url" alt="@primaryImage.AltText" class="lightbox-image" data-lightbox-img />
                </div>

                @if (hasMultipleImages)
                {
                    <button type="button" class="btn-icon lightbox-nav is-next" data-lightbox-next aria-label="@L["Product.NextImage"]">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                }
            </div>

            <p class="lightbox-caption" data-lightbox-caption>@primaryImage!.AltText</p>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/product-detail.js" asp-append-version="true" defer></script>
}
